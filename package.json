{
  "name": "bash-mastery",
  "version": "1.0.0",
  "description": "Interactive Bash learning app with xterm.js and optional pty backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "dev:all": "concurrently \"npm:start\" \"npm:dev\"",
    "build:client": "vite build",
    "preview:client": "vite preview --port 5173",
    "build": "cd client && npm run build",
    "start:prod": "npm run build && node server.js",
    "test": "jest",
    "smoke:test": "node tests/smoke-test.js",
    "test:e2e": "playwright test",
    "e2e:local": "node scripts/run-e2e.js",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "node-pty": "^0.10.1",
    "pino": "^10.1.0",
    "uuid": "^13.0.0",
    "ws": "^8.13.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@playwright/test": "^1.56.1",
    "babel-jest": "^30.2.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.12"
  }
}
